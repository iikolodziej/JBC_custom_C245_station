<mxfile host="drawio"><diagram id="wiring" name="Wiring"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="940" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:20px'&gt;JBC C245 station – wiring&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='font-size:12px'&gt;red = 24 V power · black = ground (star point) · blue = signals · purple = thermocouple · dashed = fitted, not used by the firmware&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#fffbe6;strokeColor=#d4b106;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1520" height="44" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;24 V PSU&lt;/b&gt;&lt;br&gt;Omron, ≥ 150 W" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#fde2e2;strokeColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Voltage sensor&lt;/b&gt;&lt;br&gt;input voltage → GP26&lt;br&gt;(ratio V_DIVIDER_RATIO)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#fde2e2;strokeColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="200" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;DC-DC #1&lt;/b&gt;&lt;br&gt;24 V → 5 V&lt;br&gt;Pico, Nextion, modules" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#fde2e2;strokeColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="200" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;DC-DC #2&lt;/b&gt;&lt;br&gt;24 V → LED voltage&lt;br&gt;button LEDs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#fde2e2;strokeColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="200" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ULN2803A&lt;/b&gt;&lt;br&gt;LED sink driver" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#fff3d6;strokeColor=#b7791f;" vertex="1" parent="1"><mxGeometry x="330" y="420" width="170" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;3 preset buttons&lt;/b&gt;&lt;br&gt;with LEDs&lt;br&gt;buttons to GND&lt;br&gt;LED cathodes → ULN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#fff3d6;strokeColor=#b7791f;" vertex="1" parent="1"><mxGeometry x="330" y="560" width="170" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;STAR GROUND POINT&lt;/b&gt;&lt;br&gt;one bolt / terminal" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#333333;strokeColor=#000000;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="200" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:16px'&gt;Raspberry Pi Pico 2&lt;/b&gt;&lt;br&gt;(or Pico – same pinout)&lt;br&gt;&lt;br&gt;&lt;div style='text-align:left;font-family:monospace;font-size:11px;line-height:1.5'&gt;pin 1 &amp;nbsp;GP0 &amp;nbsp;UART TX → Nextion RX&lt;br&gt;pin 2 &amp;nbsp;GP1 &amp;nbsp;UART RX ← Nextion TX&lt;br&gt;pin 4 &amp;nbsp;GP2 &amp;nbsp;LED 3 → ULN&lt;br&gt;pin 6 &amp;nbsp;GP4 &amp;nbsp;RTC SDA (spare)&lt;br&gt;pin 7 &amp;nbsp;GP5 &amp;nbsp;RTC SCL (spare)&lt;br&gt;pin 9 &amp;nbsp;GP6 &amp;nbsp;ADS1115 SDA&lt;br&gt;pin 10 GP7 &amp;nbsp;ADS1115 SCL&lt;br&gt;pin 12-16 GP9-12 SD card (spare)&lt;br&gt;pin 22 GP17 heater PWM → RPWM&lt;br&gt;pin 24 GP18 button 1&lt;br&gt;pin 25 GP19 button 2&lt;br&gt;pin 26 GP20 button 3&lt;br&gt;pin 27 GP21 LED 1 → ULN&lt;br&gt;pin 29 GP22 LED 2 → ULN&lt;br&gt;pin 31 GP26 supply voltage (ADC0)&lt;br&gt;pin 32 GP27 stand sensor&lt;br&gt;pin 34 GP28 tip-change contact&lt;br&gt;pin 36 3V3 → ADS, BTS EN, pull-up&lt;br&gt;pin 39 VSYS ← 5 V&lt;br&gt;GND → star point&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#e3f2e1;strokeColor=#2e7d32;" vertex="1" parent="1"><mxGeometry x="620" y="160" width="300" height="600" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;BTS7960 (IBT-2)&lt;/b&gt;&lt;br&gt;high-side switch&lt;br&gt;B+ ← 24 V · B− → star&lt;br&gt;M+ → heater · &lt;b&gt;M− n/c&lt;/b&gt;&lt;br&gt;RPWM ← GP17 · LPWM → GND&lt;br&gt;R_EN, L_EN, VCC ← 3.3 V" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#fde2e2;strokeColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="1060" y="90" width="220" height="130" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;T245 handle&lt;/b&gt;&lt;br&gt;C245 cartridge&lt;br&gt;&lt;br&gt;blue = heater +&lt;br&gt;red = common&lt;br&gt;green = thermocouple" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#efe3f7;strokeColor=#6a1b9a;" vertex="1" parent="1"><mxGeometry x="1380" y="90" width="180" height="150" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Input protection&lt;/b&gt;&lt;br&gt;green ─ 2.2 kΩ ─ A0&lt;br&gt;red (at socket) ─ 2.2 kΩ ─ A1&lt;br&gt;100 nF between A0 and A1&lt;br&gt;1 MΩ green → 3.3 V&lt;br&gt;&lt;i&gt;(iron side of the 2.2 kΩ)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#e1ecfb;strokeColor=#1f5fbf;" vertex="1" parent="1"><mxGeometry x="1310" y="300" width="200" height="150" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;ADS1115&lt;/b&gt;&lt;br&gt;VDD ← 3.3 V · GND → star&lt;br&gt;SDA/SCL ← GP6/GP7&lt;br&gt;ADDR → GND / open (0x48)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#e1ecfb;strokeColor=#1f5fbf;" vertex="1" parent="1"><mxGeometry x="1060" y="320" width="220" height="110" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Nextion NX3224T028&lt;/b&gt;&lt;br&gt;2.8&amp;quot; touch screen&lt;br&gt;5 V ← DC-DC #1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#fff3d6;strokeColor=#b7791f;" vertex="1" parent="1"><mxGeometry x="1060" y="480" width="220" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Stand&lt;/b&gt;&lt;br&gt;dock contact → GP27&lt;br&gt;tip-change contact → GP28&lt;br&gt;(closes to GND)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#efe3f7;strokeColor=#6a1b9a;" vertex="1" parent="1"><mxGeometry x="1060" y="600" width="220" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;RTC module&lt;/b&gt;&lt;br&gt;spare" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#f2f2f2;strokeColor=#9e9e9e;dashed=1;fontColor=#757575;" vertex="1" parent="1"><mxGeometry x="620" y="800" width="140" height="60" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;microSD module&lt;/b&gt;&lt;br&gt;spare" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#f2f2f2;strokeColor=#9e9e9e;dashed=1;fontColor=#757575;" vertex="1" parent="1"><mxGeometry x="780" y="800" width="140" height="60" as="geometry"/></mxCell><mxCell id="c19" value="+24 V" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#c0392b;strokeWidth=4;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="+24 V" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="+24 V in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="0 V" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=3;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="S → GP26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#1f5fbf;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="5 V → VSYS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="LED +" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#c0392b;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="LED −" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#1f5fbf;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="GP21 / GP22 / GP2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#1f5fbf;strokeWidth=1.5;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="GP18 / GP19 / GP20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#1f5fbf;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="GND" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.96;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="M+ → blue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#c0392b;strokeWidth=4;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="GP17 → RPWM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#1f5fbf;strokeWidth=1.5;exitX=1;exitY=0.12;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="red → star (thick wire)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=3;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1551" y="900"/><mxPoint x="140" y="900"/></Array></mxGeometry></mxCell><mxCell id="c34" value="green + red" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#6a1b9a;strokeWidth=1.5;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.66;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="A0 / A1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#6a1b9a;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="SDA / SCL  GP6 / GP7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#1f5fbf;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.33;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="TX/RX  GP1 / GP0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#1f5fbf;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="GP27 / GP28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#1f5fbf;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="GP4 / GP5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9e9e9e;strokeWidth=1.2;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="GP9–GP12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9e9e9e;strokeWidth=1.2;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• all grounds meet in one star point (PSU −, BTS B−, iron red, Pico, ADS)&lt;br&gt;• ADS1115 and BTS7960 logic from 3.3 V, never 5 V&lt;br&gt;• A1 taken with its own thin wire at the handle socket&lt;br&gt;• measure the green wire while heating before fitting the ADS1115" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.5;fillColor=#fffbe6;strokeColor=#d4b106;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1060" y="730" width="500" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>